# Copy to keystore.properties (gitignored) and fill in to sign release builds for the Play Store.
#
# Generate an upload key once:
#   keytool -genkeypair -v -keystore notova-upload.jks -alias notova-upload \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# Then point storeFile at it (absolute path or relative to the repo root) and set the passwords.
# Recommended: enroll in Play App Signing so Google manages the app signing key and this remains
# only the *upload* key.

storeFile=notova-upload.jks
storePassword=CHANGE_ME
keyAlias=notova-upload
keyPassword=CHANGE_ME
